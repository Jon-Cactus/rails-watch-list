<div class="banner mb-3" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/background.png);">
  <div class="container">
    <h1><%= @list.name %></h1>
  </div>
</div>
<div class="container">
  <%= link_to "< Back to lists", lists_path %>
  <%= link_to "Add a movie", new_list_bookmark_path(@list) %>
</div>
<div class="container d-flex flex-wrap gap-4">
  <% @list.bookmarks.each do |bookmark| %>
    <div class="card-movie w-50">
      <img src="https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/greece.jpg" />
      <div class="card-movie-infos d-block">
        <div>
          <h2><%= bookmark.movie.title %>・<%= bookmark.movie.rating %>⭐</h2>
          <p class="small-txt my-2"><%= bookmark.movie.overview %></p>
        </div>
        <div>
          <div class="d-flex flex-wrap gap-1">
            <i class="fa-solid fa-quote-left"></i>
            <p><%= bookmark.comment %></p>
          </div>
          <div>
            <%= link_to "Delete", bookmark_path(bookmark), data: { turbo_method: :delete } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
