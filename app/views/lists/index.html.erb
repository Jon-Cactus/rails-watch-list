<div class="banner mb-3" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/background.png);">
  <div class="container">
    <h1>Save any kind of movies!</h1>
    <p>Create your own lists for any purpose</p>
    <a class="btn btn-flat" href="#">Apply now</a>
  </div>
</div>
<div class="container d-flex flex-wrap justify-content-between px-4">
  <h2>My Lists</h2>
  <%= link_to "Add list", new_list_path, class: "btn btn-primary mb-3" %>
</div>
<div class="container d-flex flex-wrap gap-3 px-4">
  <% @lists.each do |list| %>
    <div class="card-category w-25" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/breakfast.jpg)">
    <%= link_to list.name, list_path(list) %>
    </div>
  <% end %>
</div>
