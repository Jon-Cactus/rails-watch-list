<div class="banner mb-3" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://img.magnific.com/free-photo/assortment-cinema-elements-red-background-with-copy-space_23-2148457848.jpg?semt=ais_hybrid&w=740&q=80);">
  <div class="container">
    <h1>Save any kind of movies!</h1>
    <p>Create your own lists for any purpose</p>
  </div>
</div>
<div class="container d-flex flex-wrap justify-content-between px-4">
  <h2>My Lists</h2>
  <%= link_to "Add list", new_list_path, class: "btn btn-primary mb-3" %>
</div>
<div class="container d-flex flex-wrap gap-3 px-4">
  <% @lists.each do |list| %>
    <div class="card-category w-25" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= list.photo.attached? ? cl_image_path(list.photo.key) : 'https://happiclap.com/wp-content/uploads/2019/06/Everyday-Clapboard-1.jpg' %>)">
    <%= link_to list.name, list_path(list) %>
    </div>
  <% end %>
</div>
